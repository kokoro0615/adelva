  "texts": [
    {
      "id": "24:6",
      "text": "ADELVA"
    },
    {
      "id": "24:8",
      "text": "課題から探す⌄"
    },
    {
      "id": "24:9",
      "text": "支援内容⌄"
    },
    {
      "id": "24:10",
      "text": "支援の進め方"
    },
    {
      "id": "24:11",
      "text": "導入事例"
    },
    {
      "id": "24:12",
      "text": "ADELVAについて⌄"
    },
    {
      "id": "I24:13;22:3",
      "text": "問い合わせを送信"
    },
    {
      "id": "I24:13;22:4",
      "text": "→"
    },
    {
      "id": "24:16",
      "text": "HOME / 課題から探す"
    },
    {
      "id": "24:17",
      "text": "総支配人・現場責任者の方へ"
    },
    {
      "id": "24:22",
      "text": "GENERAL\nMANAGERS"
    },
    {
      "id": "24:23",
      "text": "SCROLL"
    },
    {
      "id": "24:18",
      "text": "現場の課題を、\n続けられる改善へ。"
    },
    {
      "id": "40:30",
      "text": "ADELVAは、ホテル・旅館の経営実装パートナー。\n現場運営・人材・販売・ITを、一つの改善計画につなぎます。"
    },
    {
      "id": "I24:19;22:3",
      "text": "問い合わせを送信"
    },
    {
      "id": "I24:19;22:4",
      "text": "→"
    },
    {
      "id": "24:122",
      "text": "01 / 現場課題"
    },
    {
      "id": "I24:130;24:125",
      "text": "01"
    },
    {
      "id": "I24:130;24:126",
      "text": "品質"
    },
    {
      "id": "I24:130;24:127",
      "text": "サービスや清掃の品質に\nばらつきがある"
    },
    {
      "id": "I24:130;24:128",
      "text": "→"
    },
    {
      "id": "I24:135;24:125",
      "text": "02"
    },
    {
      "id": "I24:135;24:126",
      "text": "人材"
    },
    {
      "id": "I24:135;24:127",
      "text": "採用と入社後の教育が\nつながっていない"
    },
    {
      "id": "I24:135;24:128",
      "text": "→"
    },
    {
      "id": "I24:140;24:125",
      "text": "03"
    },
    {
      "id": "I24:140;24:126",
      "text": "生産性"
    },
    {
      "id": "I24:140;24:127",
      "text": "人員配置や部門間の連携を\n見直したい"
    },
    {
      "id": "I24:140;24:128",
      "text": "→"
    },
    {
      "id": "I24:145;24:125",
      "text": "04"
    },
    {
      "id": "I24:145;24:126",
      "text": "販売"
    },
    {
      "id": "I24:145;24:127",
      "text": "Web・OTA・営業が\n宿泊収益につながらない"
    },
    {
      "id": "I24:145;24:128",
      "text": "→"
    },
    {
      "id": "I24:150;24:125",
      "text": "05"
    },
    {
      "id": "I24:150;24:126",
      "text": "システム定着"
    },
    {
      "id": "I24:150;24:127",
      "text": "導入したシステムを\n現場で使い切れていない"
    },
    {
      "id": "I24:150;24:128",
      "text": "→"
    },
    {
      "id": "24:123",
      "text": "いま、現場のどこで\nつまずいていますか。"
    },
    {
      "id": "40:31",
      "text": "宿泊・料飲・清掃から、採用、販売、ITまで。\n目に見える困りごとを起点に、\n部門をまたぐ原因と改善の優先順位を整理します。"
    },
    {
      "id": "25:30",
      "text": "02 / 判断"
    },
    {
      "id": "25:31",
      "text": "施策を選ぶ前に、\n原因と優先順位を。"
    },
    {
      "id": "25:34",
      "text": "現象と原因"
    },
    {
      "id": "25:35",
      "text": "品質・工数・収益などの\n基準値から現状を捉える"
    },
    {
      "id": "25:36",
      "text": "→"
    },
    {
      "id": "25:38",
      "text": "優先順位と影響範囲"
    },
    {
      "id": "25:39",
      "text": "部門間のつながりを確認し、\n先に取り組む課題を決める"
    },
    {
      "id": "25:40",
      "text": "→"
    },
    {
      "id": "25:42",
      "text": "現場判断と、\nオーナー・本部判断"
    },
    {
      "id": "25:43",
      "text": "現場で決められることと、\n経営判断が必要なことを分ける"
    },
    {
      "id": "25:44",
      "text": "→"
    },
    {
      "id": "26:27",
      "text": "OPERATIONS"
    },
    {
      "id": "26:28",
      "text": "03 / 支援と成果物"
    },
    {
      "id": "26:32",
      "text": "01"
    },
    {
      "id": "26:33",
      "text": "一部門の品質・\n生産性を整える"
    },
    {
      "id": "26:34",
      "text": "→"
    },
    {
      "id": "26:35",
      "text": "宿泊部門運営支援／レストラン運営改善\n客室清掃改善／必要に応じて採用支援"
    },
    {
      "id": "26:36",
      "text": "→"
    },
    {
      "id": "26:37",
      "text": "標準業務手順（SOP）\n教育・検品の仕組み"
    },
    {
      "id": "26:39",
      "text": "02"
    },
    {
      "id": "26:40",
      "text": "販売・業務・ITを\nつなぎ直す"
    },
    {
      "id": "26:41",
      "text": "→"
    },
    {
      "id": "26:42",
      "text": "Web集客・チャネル収益／宿泊営業支援\nDX・システム導入"
    },
    {
      "id": "26:43",
      "text": "→"
    },
    {
      "id": "26:44",
      "text": "管理指標（KPI）\n部門間会議・運用設計"
    },
    {
      "id": "26:46",
      "text": "03"
    },
    {
      "id": "26:47",
      "text": "経営判断が必要な\n課題を進める"
    },
    {
      "id": "26:48",
      "text": "→"
    },
    {
      "id": "26:49",
      "text": "経営診断・コンサル／\n経営改善・実行支援"
    },
    {
      "id": "26:50",
      "text": "→"
    },
    {
      "id": "26:51",
      "text": "優先順位・改善計画\n判断権限・実行範囲"
    },
    {
      "id": "26:52",
      "text": "組み合わせと成果物は課題に応じて設計。改善支援・実運営・保守の範囲は、個別に合意します。"
    },
    {
      "id": "41:31",
      "text": "改善の判断"
    },
    {
      "id": "41:32",
      "text": "支援の組み合わせ例"
    },
    {
      "id": "41:33",
      "text": "現場に残すものの例"
    },
    {
      "id": "26:29",
      "text": "必要な支援を、ひとつの改善計画に。"
    },
    {
      "id": "41:30",
      "text": "一部門の改善から、販売・ITを含む運用の再設計まで。\n課題の原因と判断の範囲に応じて、支援を組み合わせます。"
    },
    {
      "id": "29:27",
      "text": "04 / 役割"
    },
    {
      "id": "29:30",
      "text": "オーナー・本部"
    },
    {
      "id": "42:33",
      "text": "経営・投資の\n判断と承認"
    },
    {
      "id": "29:31",
      "text": "GM・部門責任者"
    },
    {
      "id": "42:35",
      "text": "現場判断と\n部門間の調整"
    },
    {
      "id": "29:32",
      "text": "ADELVA"
    },
    {
      "id": "42:37",
      "text": "改善計画の推進\n実行・実装支援"
    },
    {
      "id": "29:33",
      "text": "外部関係者"
    },
    {
      "id": "42:39",
      "text": "契約に応じた\n専門領域の実施"
    },
    {
      "id": "29:35",
      "text": "判断権限・指揮命令・実行範囲・引継ぎ先を、\nお客様・ADELVA・外部関係者で個別に合意します。"
    },
    {
      "id": "29:36",
      "text": "経営・運営体制の検討から始めたい方へ"
    },
    {
      "id": "29:37",
      "text": "オーナー・経営者の方へ ↗"
    },
    {
      "id": "42:31",
      "text": "役割分担を整理する際の観点"
    },
    {
      "id": "29:28",
      "text": "任せる範囲を、\n曖昧にしない。"
    },
    {
      "id": "42:30",
      "text": "経営判断と現場の実行をつなぐために。\n関係者の役割と、引継ぎ先を整理します。"
    },
    {
      "id": "30:29",
      "text": "IMPLEMENT."
    },
    {
      "id": "30:32",
      "text": "課題把握"
    },
    {
      "id": "30:34",
      "text": "判断"
    },
    {
      "id": "30:36",
      "text": "実行・実装"
    },
    {
      "id": "30:38",
      "text": "運用"
    },
    {
      "id": "30:40",
      "text": "検証"
    },
    {
      "id": "30:42",
      "text": "引継ぎ"
    },
    {
      "id": "I30:44;22:3",
      "text": "支援の進め方を見る"
    },
    {
      "id": "I30:44;22:4",
      "text": "→"
    },
    {
      "id": "30:30",
      "text": "実行から、現場での運用へ。\n検証し、引き継ぐところまで。"
    },
    {
      "id": "42:40",
      "text": "宿泊・料飲・清掃、販売、ITの担当をつなぎ、\n支援終了後も、お客様自身が改善を続けられる状態を目指します。"
    },
    {
      "id": "31:29",
      "text": "05 / 確認する内容"
    },
    {
      "id": "31:30",
      "text": "改善の過程を、\n確認できる形に。"
    },
    {
      "id": "31:31",
      "text": "担当範囲"
    },
    {
      "id": "42:41",
      "text": "誰が、どこまで\n担うか"
    },
    {
      "id": "31:32",
      "text": "成果物"
    },
    {
      "id": "42:42",
      "text": "現場で使う手順・\n管理指標は何か"
    },
    {
      "id": "31:34",
      "text": "意思決定記録"
    },
    {
      "id": "42:43",
      "text": "何を根拠に、\n何を決めたか"
    },
    {
      "id": "31:36",
      "text": "検証・引継ぎ方法"
    },
    {
      "id": "42:44",
      "text": "何で確かめ、\n誰へ引き継ぐか"
    },
    {
      "id": "31:135",
      "text": "ADELVA"
    },
    {
      "id": "31:139",
      "text": "ADELVA"
    },
    {
      "id": "I31:141;22:6",
      "text": "問い合わせを送信"
    },
    {
      "id": "I31:141;22:7",
      "text": "→"
    },
    {
      "id": "31:146",
      "text": "課題から探す"
    },
    {
      "id": "31:147",
      "text": "支援内容"
    },
    {
      "id": "31:148",
      "text": "支援の進め方"
    },
    {
      "id": "31:149",
      "text": "導入事例"
    },
    {
      "id": "31:150",
      "text": "ADELVAについて⌄"
    },
    {
      "id": "31:152",
      "text": "プライバシーポリシー"
    },
    {
      "id": "31:153",
      "text": "サイトポリシー"
    },
    {
      "id": "31:154",
      "text": "© ADELVA"
    },
    {
      "id": "31:140",
      "text": "課題が整理できていなくても、\nお問い合わせいただけます。"
    },
    {
      "id": "42:45",
      "text": "現状やお困りのことから、お聞かせください。\n必要な支援内容と、双方の役割を整理します。"
    }
  ],
