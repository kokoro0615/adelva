      "id": "70:23",
      "text": "外部関係者"
    },
    {
      "id": "70:26",
      "text": "意思決定・権限・担当範囲・成果物を合意する"
    },
    {
      "id": "70:28",
      "text": "権限・担当範囲・条件は、個別の契約で確認します。"
    },
    {
      "id": "70:30",
      "text": "総支配人・現場責任者の方へ"
